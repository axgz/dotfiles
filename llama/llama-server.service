[Unit]
Description=Llama.cpp Inference Server
After=network.target

[Service]
Type=simple
User=llama
Group=llama
WorkingDirectory=/var/lib/llama
Environment="LD_LIBRARY_PATH=/opt/llama.cpp/lib64"
LimitMEMLOCK=infinity

ExecStart=/opt/llama.cpp/bin/llama-server \
    --models-dir /var/lib/llama/models \
    --host 0.0.0.0 \
    --port 8089 \
    --ngl 0 \
    --threads 6 \
    --batch-size 4096 \
    --ubatch-size 512 \
    --ctx-size 16384 \
    --load-mode mlock

Restart=always
RestartSec=5

# Security Hardening (Optional but recommended)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/llama

[Install]
WantedBy=multi-user.target


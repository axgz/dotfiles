[Unit]
Description=Llama.cpp Inference Server
After=network.target

[Service]
Type=simple
User=llama
Group=llama
WorkingDirectory=/var/lib/llama
Environment="LD_LIBRARY_PATH=/opt/llama.cpp/lib64"
LimitMEMLOCK=infinity

# Adjust the command line for your specific model and hardware
# -m: Path to your GGUF model
# -ngl: Number of layers to offload to GPU (use 99 for all)
# --host 0.0.0.0: Allow external connections
ExecStart=/opt/llama.cpp/bin/llama-server -m /var/lib/llama/models/default.gguf \
    --host 0.0.0.0 \
    --port 8089 \
    --threads 8 \
    --batch-size 4096 \
    --ubatch-size 512 \
    --ctx-size 4096 \
    --mlock

Restart=always
RestartSec=5

# Security Hardening (Optional but recommended)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/llama

[Install]
WantedBy=multi-user.target

